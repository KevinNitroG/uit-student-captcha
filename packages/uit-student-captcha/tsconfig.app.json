{
  // App (browser): the userscript sources Vite bundles for Tampermonkey.
  // Browser runtime → DOM libs, no Node. Specs are excluded (they live in `spec`).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "outDir": "./out-tsc/app",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
