{
  // Node: build-tooling config files only (they run on Node, not in the browser).
  // No DOM lib here — catches accidental DOM usage in build config. Delete this
  // project (and its solution reference) if you prefer the upstream template's
  // approach of not typechecking config files at all.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"]
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
